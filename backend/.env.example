PORT=3000
NODE_ENV=development

# Meta / WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-longo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
GRAPH_API_VERSION=v23.0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Protege o endpoint interno de pedidos
ADMIN_API_TOKEN=troque-por-outro-token-longo

# Opcional: número pessoal do responsável para receber alerta de novo pedido.
# Use somente dígitos com DDI e DDD, ex.: 5521999999999
OWNER_ALERT_NUMBER=

# O combo anterior tinha preço próprio, mas o valor após a troca para refrigerantes 1,5 L
# ainda precisa ser confirmado. Deixe 0 para o bot informar que o preço do refrigerante será confirmado.
PIZZA_DRINK_COMBO_PRICE=0
